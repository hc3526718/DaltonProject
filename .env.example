# Copy to .env (not committed). Expo loads EXPO_PUBLIC_* at build time.

# --- Supabase (Postgres + Auth + Storage) — chosen default stack ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Web deployment (Vercel: daltongrantacademy.vercel.app) ---
# Marketing site origin (legal links, OAuth fallback when window.location unavailable at build time).
# Set the same value in EAS Environment Variables as EXPO_PUBLIC_DALTON_WEB_URL (not EAS_PUBLIC_*).
EXPO_PUBLIC_DALTON_WEB_URL=https://daltongrantacademy.vercel.app
# Expo web export base path (must match vercel.json /app route and Supabase redirect URLs)
EXPO_PUBLIC_WEB_BASE_PATH=/app
# Optional override for Google OAuth callback (default: {DALTON_WEB_URL}{WEB_BASE_PATH}/auth/callback)
# EXPO_PUBLIC_OAUTH_REDIRECT_URL=https://daltongrantacademy.vercel.app/app/auth/callback

# --- App Store / Play Store screenshot builds (fictional feed data merged in app) ---
# Set to 1 only while capturing store screenshots; leave unset in production.
# EXPO_PUBLIC_APP_STORE_SCREENSHOTS=1

# --- Development-only offline login (when Supabase env is missing; never used in release builds) ---
# EXPO_PUBLIC_DEV_DEMO_LEGACY_PASSWORD=
# EXPO_PUBLIC_DEV_DEMO_PREMIUM_PASSWORD=

# --- Media search fictional tiles (when Supabase off). Production: leave unset. Dev/screenshots: auto or set 1. ---
# EXPO_PUBLIC_ALLOW_MEDIA_SEARCH_DEMO=1

# --- Android HTTP cleartext (local Metro / LAN only). Production: leave unset (HTTPS only). ---
# EXPO_PUBLIC_ANDROID_ALLOW_CLEARTEXT=true


# --- RevenueCat (native + Web Billing in RC dashboard — see docs/REVENUECAT_BILLING_SETUP.md) ---
# Use App Store / Play public SDK keys only (`appl_` / `goog_`). Test Store keys (`test_…`) are not read by the app.
# iOS: Dashboard → Apps → The Dalton Grant Academy (App Store), com.hc111.daltondemo → Public SDK key (starts with appl_)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# Android: add a Google Play app to the RC project first, then its public SDK key (typically goog_)
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# Dashboard project id (API v2 / RevenueCat MCP). SDK does not need this at runtime; set for Cursor / scripts.
EXPO_PUBLIC_REVENUECAT_PROJECT_ID=proj88ab5ee7

# Edge Function `master-delete-user`: set SUPABASE_SERVICE_ROLE_KEY in Supabase Dashboard →
# Edge Functions → Secrets (never ship service role in Expo or commit it).
# Entitlement identifier in RevenueCat (must match exactly)
# SDK + webhook accept either identifier (App Store uses "Grant Access Pro" in RC dashboard).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# Optional: RevenueCat offering **lookup key** for Paywall UI (defaults try Official Offering → default → current).
# Use when your paywall is tied to an offering that is not the dashboard "current" offering (e.g. current still has Test Store SKUs).
# EXPO_PUBLIC_REVENUECAT_OFFERING_IDENTIFIER=Official Offering

# Optional: Google Places autocomplete for event venue (web create-event wizard)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Publishable key is safe in the client bundle (pk_test_… / pk_live_…).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: override plan card copy on web paywall (JSON array; see StripePremiumPaywall defaults).
# EXPO_PUBLIC_STRIPE_PLAN_LABELS=[{"key":"monthly","title":"Monthly","priceLine":"$9.99 / month","description":"..."}]
#
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets), NOT in this file:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#   STRIPE_PRICE_ACCESS_MONTHLY_ID — £2/mo academy access (e.g. price_1TbkdqRiVFlZ45SIMWXBnSCH)
# Paywall unlocks when subscription_state.is_payment_verified is true (Stripe + RevenueCat webhooks).
#   STRIPE_PRICE_MONTHLY_ID, STRIPE_PRICE_ANNUAL_ID (optional legacy premium plans)
# Deploy: stripe-create-checkout, stripe-webhook
# Webhook URL: https://<PROJECT_REF>.supabase.co/functions/v1/stripe-webhook

# --- Backend API (your Edge Functions / custom server) ---
EXPO_PUBLIC_API_BASE_URL=

# --- Resend (email) — do NOT import in React Native; keys must not ship in the app bundle. ---
# Local test only: `cd expo-app && npm run test:resend` (uses `scripts/test-resend-email.mjs`).
# Prefer RESEND_API_KEY in .env so the name does not suggest a public/bundled variable.
RESEND_API_KEY=re_xxxxxxxxx
# Optional mirror for the same local script (replace with your real key from https://resend.com/api-keys ):
# EXPO_PUBLIC_RESEND_API_KEY=

# Production / post-report webhook: set RESEND_API_KEY (and other secrets) on Supabase → Edge Function
# `send-post-report-email`, not in Expo env.

# --- Ticket QR signing (must match server HMAC secret in production) ---
EXPO_PUBLIC_TICKET_SIGNING_SECRET=demo-only-change-in-production

# --- Sentry (optional; errors + boot/Rive diagnostics) ---
# EXPO_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# Forward console.error to Sentry in release (default on). Set 0 to disable. Set 1 in __DEV__ to test forwarding.
# EXPO_PUBLIC_SENTRY_FORWARD_CONSOLE_ERRORS=0
# Plugin config (stops "Missing config for organization, project" during EAS build/update):
# SENTRY_ORG=your-sentry-org-slug
# SENTRY_PROJECT=your-sentry-project-slug
# EAS: eas.json sets SENTRY_DISABLE_AUTO_UPLOAD=true so builds succeed without SENTRY_AUTH_TOKEN.
# To upload source maps: set SENTRY_AUTH_TOKEN in EAS secrets and SENTRY_DISABLE_AUTO_UPLOAD=false on that profile.

# --- Boot & pull-to-refresh Rive (optional) — defaults to Rive Cloud embed URL (WebView); no bundled .riv ---
# EXPO_PUBLIC_BOOT_USE_RIVE=0
# Rive: default is bundled dalton_animated_logo.riv (native + web canvas, no grey embed).
# Force Cloud embed iframe instead:
# EXPO_PUBLIC_RIVE_FORCE_EMBED=1
# EXPO_PUBLIC_RIVE_EMBED_URL=https://rive.app/s/.../embed?runtime=rive-renderer
# Expo Go: embed unless bounce-only:
# EXPO_PUBLIC_RIVE_DISABLE_EMBED=1
# Native player from hosted .riv (requires EXPO_PUBLIC_RIVE_USE_NATIVE_URL=1):
# EXPO_PUBLIC_RIVE_URL=https://.../file.riv
# EXPO_PUBLIC_RIVE_USE_NATIVE_URL=1
# EXPO_PUBLIC_RIVE_EMBED_SCALE=3.5
